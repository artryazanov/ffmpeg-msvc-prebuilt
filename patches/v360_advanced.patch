+            return ret;
+    } else {
+        AVFilterPad pad = { 0 };
+        pad.type = AVMEDIA_TYPE_VIDEO;
+        pad.name = av_strdup("default");
+        if (!pad.name) return AVERROR(ENOMEM);
+        pad.filter_frame = filter_frame;
+        ret = avfilter_insert_inpad(ctx, 0, &pad);
+        av_free((void*)pad.name);
+        if (ret < 0) return ret;
+    }
+
     return 0;
 }
 
